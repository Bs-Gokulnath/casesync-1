# Copy to .env and adjust for local development. Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=casesync
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=casesync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- API (apps/api) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://casesync:change-me-dev-only@localhost:5432/casesync
SESSION_SECRET=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=casesync_session
CSRF_COOKIE_NAME=casesync_csrf
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# --- Web (apps/web) ---
# Server-side only; never exposed to the browser via NEXT_PUBLIC_*
API_INTERNAL_URL=http://localhost:8000
